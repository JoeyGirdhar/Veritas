# Copy to ".env" and fill in to use the real Claude backend (the --real flag).
# Mock mode (the default) needs none of this.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pick a cheaper model while experimenting.
# Default is claude-opus-5. Cheaper options: claude-sonnet-5, claude-haiku-4-5
# AGENT_MODEL=claude-haiku-4-5

# Optional: force mock mode even if a key is set.
# USE_MOCK=1
